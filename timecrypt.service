[Unit]
Description=The SaaS for time_crypt
After=network.target

[Service]
WorkingDirectory=/home/user/time_crypt/
ExecStart=/home/hammad/user/venv/bin/uvicorn main:app --host 0.0.0.0 --port 31415
Restart=always
Environment="KEYS_JSON=/home/user/time_crypt/keys.json"

[Install]
WantedBy=multi-user.target
